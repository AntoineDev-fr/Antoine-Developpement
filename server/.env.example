PORT=3000

# EmailJS
EMAILJS_SERVICE_ID=...
EMAILJS_TEMPLATE_ID=...
EMAILJS_PUBLIC_KEY=...
# Optional, only if you use a private access token
# EMAILJS_ACCESS_TOKEN=your_access_token

# Rate limit
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=5

# Validation
MAX_MESSAGE_LENGTH=4000
MAX_NAME_LENGTH=200

# Origines autorisees en cross-origin pour /api/* (separees par des virgules).
# Vide/absent = pas de requete cross-origin autorisee (defaut hors dev).
CORS_ORIGINS=
