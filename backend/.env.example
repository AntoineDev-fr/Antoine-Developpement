# Token requis (header "Authorization: Bearer <token>") pour ajouter,
# modifier ou supprimer un projet, et pour uploader une image.
# Generez une valeur longue et aleatoire, par ex.: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me-to-a-long-random-string

# Optionnel, ne jamais activer en production (active le debugger Werkzeug)
FLASK_DEBUG=0

# Chemin absolu vers la base SQLite. Par defaut (si absent): backend/portfolio.db en local.
DATABASE_PATH=

# Origines autorisees en cross-origin pour /api/projects et /api/upload (separees par des virgules).
# Vide/absent = pas de requete cross-origin autorisee (defaut hors dev).
CORS_ORIGINS=
