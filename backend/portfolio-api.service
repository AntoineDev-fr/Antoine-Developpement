[Unit]
Description=Portfolio API (Flask)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/Antoine-Developpement/backend
EnvironmentFile=/var/www/Antoine-Developpement/backend/.env
ExecStart=/var/www/Antoine-Developpement/backend/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8001 app:app
Restart=always
RestartSec=5
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
